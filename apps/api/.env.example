# ─── API Environment Variables ────────────────────────────────────────────────
# Copy this file to .env and fill in the values

# PostgreSQL connection string (from Render PostgreSQL dashboard)
DATABASE_URL=postgres://user:password@host/dbname

# Strong random secret for signing session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-strong-random-string

# Port the API listens on (Render sets this automatically)
PORT=4000

# Set to "production" on Render
NODE_ENV=production

# Full URL of your deployed Next.js frontend on Render
# e.g. https://agency-web.onrender.com
WEB_ORIGIN=https://your-frontend.onrender.com
