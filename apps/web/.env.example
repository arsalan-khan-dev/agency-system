# ─── Web Environment Variables ────────────────────────────────────────────────
# Copy this file to .env.local for local development
# Set these as Environment Variables on Render for production

# Full URL of your deployed NestJS API on Render (no trailing slash)
# e.g. https://agency-api.onrender.com
API_URL=https://your-api.onrender.com

# Public URL of this Next.js app (used for absolute links/SEO)
NEXT_PUBLIC_APP_URL=https://your-frontend.onrender.com
